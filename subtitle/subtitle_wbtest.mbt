///|
fn sample_srt() -> String {
  "1\n00:00:01,000 --> 00:00:03,200\nHello MoonBit.\nSecond line.\n\n2\n00:00:04,000 --> 00:00:05,500\nQC-ready subtitles.\n"
}

///|
test "srt parser keeps cue indices timing and text" {
  match parse_srt(sample_srt()) {
    Some(track) => {
      assert_true(track.format == Srt)
      assert_eq(track.cues.length(), 2)
      assert_true(track.cues[0].index == Some(1))
      assert_eq(track.cues[0].start_ms, 1000)
      assert_eq(track.cues[0].end_ms, 3200)
      assert_eq(track.cues[0].text.length(), 2)
      assert_eq(track.cues[0].text[1], "Second line.")
    }
    None => fail("expected SRT track")
  }
}

///|
test "srt writer normalizes stable output" {
  match parse_srt(sample_srt()) {
    Some(track) =>
      assert_eq(
        write_srt(track),
        "1\n00:00:01,000 --> 00:00:03,200\nHello MoonBit.\nSecond line.\n\n2\n00:00:04,000 --> 00:00:05,500\nQC-ready subtitles.\n",
      )
    None => fail("expected SRT track")
  }
}

///|
test "webvtt parser preserves settings and writes vtt" {
  let raw = "WEBVTT\n\nfirst\n00:00:01.000 --> 00:00:02.000 align:start\nHello\n\n00:00:03.000 --> 00:00:04.250\nWorld\n"
  match parse_webvtt(raw) {
    Some(track) => {
      assert_true(track.format == WebVtt)
      assert_eq(track.cues.length(), 2)
      assert_true(track.cues[0].identifier == Some("first"))
      assert_eq(track.cues[0].settings, "align:start")
      assert_true(
        write_webvtt(track).has_prefix(
          "WEBVTT\n\nfirst\n00:00:01.000 --> 00:00:02.000 align:start",
        ),
      )
    }
    None => fail("expected WebVTT track")
  }
}

///|
test "timestamp parser accepts srt and webvtt separators" {
  assert_true(parse_timestamp_ms("00:00:01,250") == Some(1250))
  assert_true(parse_timestamp_ms("00:00:01.250") == Some(1250))
  assert_eq(format_srt_timestamp(3723456), "01:02:03,456")
  assert_eq(format_vtt_timestamp(3723456), "01:02:03.456")
}

///|
test "srt parser accepts crlf and utf8 bom" {
  let raw = "\u{FEFF}1\r\n00:00:01,000 --> 00:00:02,000\r\nHello\r\n"
  match parse_srt(raw) {
    Some(track) => {
      assert_eq(track.cues.length(), 1)
      assert_true(track.cues[0].index == Some(1))
      assert_eq(track.cues[0].text[0], "Hello")
    }
    None => fail("expected BOM SRT")
  }
}

///|
test "srt parser accepts cue without numeric index" {
  match parse_srt("00:00:01,000 --> 00:00:02,000\nHello\n") {
    Some(track) => {
      assert_true(track.cues[0].index is None)
      assert_eq(track.cues[0].text[0], "Hello")
    }
    None => fail("expected indexless cue")
  }
}

///|
test "srt parser rejects malformed timing" {
  assert_true(parse_srt("1\n00:00:61,000 --> 00:00:02,000\nBad\n") is None)
}

///|
test "srt parser exposes line and block for malformed timing" {
  match parse_srt_detailed("1\n00:00:61,000 --> 00:00:02,000\nBad\n") {
    Err(error) => {
      assert_true(error.format == Some(Srt))
      assert_eq(error.block, 1)
      assert_eq(error.line, 2)
      assert_true(error.message.contains("timing"))
    }
    Ok(_) => fail("expected parse error")
  }
}

///|
test "webvtt parser rejects missing header" {
  assert_true(parse_webvtt("00:00:01.000 --> 00:00:02.000\nHello\n") is None)
}

///|
test "webvtt parser exposes missing header error" {
  match parse_webvtt_detailed("00:00:01.000 --> 00:00:02.000\nHello\n") {
    Err(error) => {
      assert_true(error.format == Some(WebVtt))
      assert_eq(error.line, 1)
      assert_true(error.message.contains("WEBVTT"))
    }
    Ok(_) => fail("expected parse error")
  }
}

///|
test "webvtt parser ignores note style and region blocks" {
  let raw = "WEBVTT\n\nNOTE generated by MoonPost\nignore me\n\nSTYLE\n::cue { color: white; }\n\nREGION\nid:top\n\n00:00:01.000 --> 00:00:02.000\nHello\n"
  match parse_webvtt(raw) {
    Some(track) => {
      assert_eq(track.cues.length(), 1)
      assert_eq(track.cues[0].text[0], "Hello")
    }
    None => fail("expected VTT with metadata blocks")
  }
}

///|
test "srt recovery returns partial cues and collects all errors" {
  let raw = "1\n00:00:01,000 --> 00:00:02,000\nGood cue 1\n\n2\nBAD TIMING\nBad cue\n\n3\n00:00:03,000 --> 00:00:04,000\nGood cue 2\n"
  let result = parse_srt_with_recovery(raw)
  assert_eq(result.cues().length(), 2)
  assert_true(result.has_errors())
  assert_eq(result.error_count(), 1)
  assert_true(result.errors[0].message.contains("timing"))
  assert_eq(result.cues()[0].text[0], "Good cue 1")
  assert_eq(result.cues()[1].text[0], "Good cue 2")
}

///|
test "srt recovery collects multiple bad blocks" {
  let raw = "1\nBAD\nBlock 1\n\n2\n00:00:01,000 --> 00:00:02,000\nGood\n\n3\nALSO BAD\nBlock 3\n"
  let result = parse_srt_with_recovery(raw)
  assert_eq(result.cues().length(), 1)
  assert_eq(result.error_count(), 2)
}

///|
test "srt recovery returns empty track for all bad input" {
  let result = parse_srt_with_recovery("garbage\ngarbage\n")
  assert_eq(result.cues().length(), 0)
  assert_eq(result.error_count(), 1)
  assert_true(result.track.format == Srt)
}

///|
test "srt recovery returns zero errors for clean input" {
  let raw = "1\n00:00:01,000 --> 00:00:02,000\nHello\n\n2\n00:00:03,000 --> 00:00:04,000\nWorld\n"
  let result = parse_srt_with_recovery(raw)
  assert_eq(result.cues().length(), 2)
  assert_false(result.has_errors())
  assert_eq(result.error_count(), 0)
}

///|
test "webvtt recovery returns partial cues alongside errors" {
  let raw = "WEBVTT\n\n00:00:01.000 --> 00:00:02.000\nGood cue\n\nBAD BLOCK\n\n00:00:03.000 --> 00:00:04,000\nAnother good\n"
  let result = parse_webvtt_with_recovery(raw)
  assert_eq(result.cues().length(), 2)
  assert_eq(result.error_count(), 1)
  assert_true(result.errors[0].message.contains("timing"))
}

///|
test "webvtt recovery reports missing header error" {
  let raw = "00:00:01.000 --> 00:00:02.000\nHello\n"
  let result = parse_webvtt_with_recovery(raw)
  assert_eq(result.cues().length(), 0)
  assert_true(result.has_errors())
  assert_true(result.errors[0].message.contains("WEBVTT"))
}

///|
test "recovery errors preserve block and line numbers" {
  let raw = "1\n00:00:01,000 --> 00:00:02,000\nFirst\n\n2\nbad timing\nSecond\n\n3\n00:00:03,000 --> 00:00:04,000\nThird\n"
  let result = parse_srt_with_recovery(raw)
  assert_eq(result.error_count(), 1)
  assert_eq(result.errors[0].block, 2)
  assert_eq(result.errors[0].line, 6)
}
